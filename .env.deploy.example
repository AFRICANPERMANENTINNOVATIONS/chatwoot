# ===========================================
# PerfectCX Production Environment Variables
# Copy this to .env and fill in the values
# ===========================================

# --- App ---
FRONTEND_URL=https://perfectcx.permanentinnovations.africa
SECRET_KEY_BASE=  # Generate with: openssl rand -hex 64
DEFAULT_LOCALE=fr

# --- Database ---
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=  # Set a strong password

# --- Redis ---
REDIS_PASSWORD=  # Set a strong password

# --- Logging ---
LOG_LEVEL=info

# --- Account ---
ENABLE_ACCOUNT_SIGNUP=false

# --- Storage (local or amazon for S3/MinIO) ---
ACTIVE_STORAGE_SERVICE=local
# For S3:
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=perfectcx-storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# For MinIO (self-hosted S3):
# AWS_ENDPOINT=http://minio:9000
# FORCE_PATH_STYLE=true

# --- Email (SMTP) ---
# MAILER_SENDER_EMAIL=noreply@perfectcx.permanentinnovations.africa
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true

# --- WhatsApp ---
# WHATSAPP_APP_ID=928716640114449
# WHATSAPP_APP_SECRET=
